# PostgreSQL connection — Railway auto-injects this via ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://clinicflow:clinicflow@localhost:5432/clinicflow?schema=public"

JWT_SECRET="change_me_long_random_string"
PORT=4000
OPENAI_API_KEY=""
WHATSAPP_VERIFY_TOKEN="clinicflow_verify"
WHATSAPP_BSP_URL=""
WHATSAPP_BSP_TOKEN=""
CLINIC_NAME="Demo Skin Clinic"
CLINIC_BOOKING_URL="http://localhost:3000/book"
# Optional: clinic UPI ID (e.g. clinicname@ybl). When set, invoice QR uses UPI collect with amount; otherwise QR encodes paymentUrl.
CLINIC_UPI_VPA=""

# Google Sign-In — OAuth 2.0 Web Client ID (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend)
GOOGLE_CLIENT_ID=""
